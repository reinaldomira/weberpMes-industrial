rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra padrão de segurança: negar tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // FUNÇÕES AUXILIARES DE SEGURANÇA E ISOLAMENTO MULTI-TENANT
    // -------------------------------------------------------------
    
    // Verifica se a requisição provém de um usuário autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifica se o usuário autenticado é membro ativo da empresa especificada
    function isMemberOf(companyId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Verifica se o usuário autenticado possui papel de administrador ativo na empresa
    function isAdminOf(companyId) {
      return isMemberOf(companyId) &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------
    // 1. EMPRESAS (CADASTRO E ISOLAMENTO DE TENANT)
    // -------------------------------------------------------------
    match /companies/{companyId} {
      // Somente membros ativos da empresa podem ler os dados da sua empresa
      allow read: if isMemberOf(companyId);
      
      // Criação de novas empresas pelo frontend é terminantemente bloqueada.
      // O provisionamento de empresas e do primeiro admin deve ocorrer via Console ou backend confiável.
      allow create: if false;
      
      // Apenas administradores da própria empresa podem atualizar dados cadastrais
      allow update: if isAdminOf(companyId);
      
      // Exclusão de empresas é bloqueada no cliente
      allow delete: if false;

      // -----------------------------------------------------------
      // 2. MEMBROS DA EMPRESA (/companies/{companyId}/members/{memberUid})
      // -----------------------------------------------------------
      match /members/{memberUid} {
        // Leitura: membros da empresa podem ver a equipe, ou o próprio usuário pode ver seu vínculo
        allow read: if isMemberOf(companyId) || (isAuthenticated() && request.auth.uid == memberUid);

        // Criação de novos membros: exclusivamente pelo administrador da empresa
        allow create: if isAdminOf(companyId) 
          && request.resource.data.companyId == companyId
          && request.resource.data.uid == memberUid;

        // Atualização: exclusivamente pelo administrador da empresa.
        // Impede que membros comuns alterem seu próprio papel (role) ou de terceiros.
        allow update: if isAdminOf(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.uid == memberUid;

        // Remoção de membros: exclusivamente pelo administrador da empresa
        allow delete: if isAdminOf(companyId);
      }
    }

    // Consulta em grupo de coleções para que o usuário autenticado encontre suas empresas
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated() && request.auth.uid == memberUid;
    }

    // -------------------------------------------------------------
    // 3. MÓDULO DE FERRAMENTARIA (PREPARAÇÃO COM ISOLAMENTO POR TENANT)
    // -------------------------------------------------------------
    
    // Ordens de Serviço (OS):
    // Acesso permitido SOMENTE se o usuário for membro da empresa indicada no documento
    match /tooling_orders/{orderId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.companyId);
      allow create: if isAuthenticated() && isMemberOf(request.resource.data.companyId);
      allow update: if isAuthenticated() 
        && isMemberOf(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAuthenticated() && isAdminOf(resource.data.companyId);
    }

    // Apontamentos de Horas de Ferramentaria:
    // Vinculados à empresa e ao operador
    match /tooling_time_entries/{entryId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.companyId);
      allow create: if isAuthenticated() 
        && isMemberOf(request.resource.data.companyId);
      allow update: if isAuthenticated() 
        && isMemberOf(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAuthenticated() && (
        isAdminOf(resource.data.companyId) || 
        (resource.data.ownerUid == request.auth.uid && isMemberOf(resource.data.companyId))
      );
    }

    // Centros de Trabalho e Recursos:
    match /work_centers/{workCenterId} {
      allow read: if isAuthenticated() && isMemberOf(resource.data.companyId);
      allow create, update: if isAuthenticated() 
        && isMemberOf(request.resource.data.companyId)
        && isAdminOf(request.resource.data.companyId);
      allow delete: if isAuthenticated() && isAdminOf(resource.data.companyId);
    }

    // -------------------------------------------------------------
    // 4. DEMAIS COLEÇÕES INDUSTRIAIS (ISOLAMENTO POR COMPANY_ID)
    // -------------------------------------------------------------
    match /production_orders/{orderId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /shop_floor_logs/{logId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /quotes/{quoteId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /materials/{materialId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /quality_inspections/{inspectionId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /non_conformance_reports/{rncId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /maintenance_records/{recordId} {
      allow read, write: if isAuthenticated() && isMemberOf(resource.data.companyId);
    }

    match /company_config/{configId} {
      allow read: if isAuthenticated() && isMemberOf(configId);
      allow write: if isAuthenticated() && isAdminOf(configId);
    }
  }
}
